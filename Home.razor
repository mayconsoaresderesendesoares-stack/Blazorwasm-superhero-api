@page "/"
@using System.Net.Http.Json
@using BlazorWasmSuperHeroApi.Models
@inject HttpClient Http

<PageTitle>SuperHero Search</PageTitle>

<div class="container py-4">
    <div class="row justify-content-center mb-4">
        <div class="col-md-8 text-center">
            <h1 class="display-5 fw-bold text-primary mb-2">SuperHero Search</h1>
            <p class="text-muted">Busque por heróis e vilões usando a API oficial do SuperHero.</p>

            <div class="input-group shadow-sm">
                <input type="text"
                       class="form-control form-control-lg"
                       placeholder="Ex: batman, ironman, spider..."
                       @bind="searchTerm"
                       @bind:event="oninput"
                       @onkeypress="HandleKeyPress" />
                <button class="btn btn-primary px-4"
                        type="button"
                        @onclick="SearchHeroes"
                        disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>A pesquisar...</span>
                    }
                    else
                    {
                        <span>Pesquisar</span>
                    }
                </button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger shadow-sm" role="alert">
            @errorMessage
        </div>
    }

    @if (heroes != null && heroes.Any())
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var hero in heroes)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        <img src="@hero.Image.Url"
                             class="card-img-top"
                             style="height: 300px; object-fit: cover;"
                             alt="@hero.Name" />
                        <div class="card-body">
                            <h5 class="card-title fw-bold">
                                @hero.Name
                                @if (!string.IsNullOrWhiteSpace(hero.Biography.FullName))
                                {
                                    <span class="text-muted fs-6">(@hero.Biography.FullName)</span>
                                }
                            </h5>
                            <p class="card-text text-muted small mb-2">
                                <strong>Editora:</strong> @hero.Biography.Publisher
                            </p>
                            <hr class="text-muted opacity-25" />
                            <h6 class="text-uppercase small text-secondary fw-bold">Powerstats</h6>
                            <ul class="list-unstyled small mb-3">
                                <li>Inteligência: <strong>@hero.Powerstats.Intelligence</strong></li>
                                <li>Força: <strong>@hero.Powerstats.Strength</strong></li>
                                <li>Velocidade: <strong>@hero.Powerstats.Speed</strong></li>
                                <li>Combate: <strong>@hero.Powerstats.Combat</strong></li>
                            </ul>
                            <h6 class="text-uppercase small text-secondary fw-bold">Aparição</h6>
                            <p class="small text-muted mb-0">@hero.Biography.FirstAppearance</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (hasSearched && !isLoading && string.IsNullOrEmpty(errorMessage))
    {
        <div class="text-center text-muted py-5">
            <p class="fs-5">Nenhum personagem encontrado para "@searchTerm".</p>
        </div>
    }
</div>

@code {
    private string searchTerm = string.Empty;
    private List<SuperHero>? heroes;
    private string errorMessage = string.Empty;
    private bool isLoading = false;
    private bool hasSearched = false;

    private readonly string accessToken = "583bc6d734ac0c6e28e3aed8e1831e07";

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchHeroes();
        }
    }

    private async Task SearchHeroes()
    {
        if (string.IsNullOrWhiteSpace(searchTerm)) return;

        isLoading = true;
        hasSearched = true;
        errorMessage = string.Empty;
        heroes = null;

        try
        {
            string url = $"https://www.superheroapi.com/api.php/{accessToken}/search/{Uri.EscapeDataString(searchTerm.Trim())}";
            var result = await Http.GetFromJsonAsync<SuperHeroResponse>(url);

            if (result != null && string.Equals(result.Response, "success", StringComparison.OrdinalIgnoreCase))
            {
                heroes = result.Results;
            }
            else
            {
                heroes = new List<SuperHero>();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ocorreu um erro ao conectar com a API: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}